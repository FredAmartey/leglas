{
  "name": "leglas-mcp",
  "version": "0.8.0",
  "description": "Stdio MCP server exposing Leglas to agent hosts that cannot run a shell.",
  "type": "module",
  "bin": {
    "leglas-mcp": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "cp ../../README.md ./README.md"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "leglas": "workspace:^",
    "zod": "^3.25.76"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FredAmartey/leglas.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/FredAmartey/leglas#readme",
  "engines": {
    "node": ">=24"
  }
}
